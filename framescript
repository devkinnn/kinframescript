-- kintest: single-file, local Studio test panel.
-- Workspace Script, RunContext = Client. No existing source files are modified.
-- Avatar overlay is cosmetic and local; identity, hitboxes and server state stay intact.
local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local UIS=game:GetService("UserInputService")
local RS=game:GetService("ReplicatedStorage")
if not RunService:IsStudio() then return end
local player=Players.LocalPlayer
if not player then return end
local playerGui=player:WaitForChild("PlayerGui")
if playerGui:FindFirstChild("kintestUI") then return end

local gui=Instance.new("ScreenGui")
gui.Name="kintestUI" gui.ResetOnSpawn=false gui.DisplayOrder=200 gui.Parent=playerGui
local panel=Instance.new("Frame")
panel.Name="Panel" panel.Position=UDim2.fromOffset(24,150) panel.Size=UDim2.fromOffset(330,405)
panel.BackgroundColor3=Color3.fromRGB(24,27,36) panel.BorderSizePixel=0 panel.Parent=gui
local stroke=Instance.new("UIStroke",panel) stroke.Color=Color3.fromRGB(105,144,208) stroke.Thickness=2
local function label(text,y,height)
 local t=Instance.new("TextLabel") t.BackgroundTransparency=1 t.Position=UDim2.fromOffset(16,y)
 t.Size=UDim2.new(1,-32,0,height or 24) t.Font=Enum.Font.Gotham t.TextSize=14
 t.TextColor3=Color3.fromRGB(220,228,243) t.TextXAlignment=Enum.TextXAlignment.Left
 t.TextWrapped=true t.Text=text t.Parent=panel return t
end
local function button(name,text,y)
 local b=Instance.new("TextButton") b.Name=name b.Position=UDim2.fromOffset(16,y) b.Size=UDim2.new(1,-32,0,34)
 b.BackgroundColor3=Color3.fromRGB(49,67,100) b.BorderSizePixel=0 b.Font=Enum.Font.GothamBold
 b.TextSize=14 b.TextColor3=Color3.new(1,1,1) b.Text=text b.Parent=panel return b
end
local function box(name,placeholder,text,y)
 local b=Instance.new("TextBox") b.Name=name b.Position=UDim2.fromOffset(16,y) b.Size=UDim2.new(1,-32,0,32)
 b.BackgroundColor3=Color3.fromRGB(36,40,53) b.BorderSizePixel=0 b.Font=Enum.Font.Gotham
 b.TextSize=14 b.TextColor3=Color3.new(1,1,1) b.PlaceholderText=placeholder b.Text=text b.ClearTextOnFocus=false
 b.Parent=panel return b
end
label("KINTEST  /  STUDIO",12).Font=Enum.Font.GothamBold
local toggle=button("TriggerToggle","TRIGGER TEST: OFF",47)
label("Delay in milliseconds (0–5000)",88)
local delayBox=box("TriggerDelay","Milliseconds","150",114)
local targetLabel=label("Aim at a visible opponent.",153,36)
label("LOCAL AVATAR • username, not display name",201)
local username=box("AvatarUsername","Roblox username","",231)
local apply=button("ApplyAvatar","PREVIEW AVATAR",274)
local reset=button("ResetAvatar","RESTORE MY AVATAR",316)
local status=label("Right Shift: show / hide panel",358,36)

local enabled=false
local delaySeconds=.15
local candidate=nil
local acquired=0
local nextFire=0
local attackInput=nil
task.spawn(function()
 local ext=RS:FindFirstChild("Extensions")
 local module=ext and ext:FindFirstChild("InputMap")
 if module then
  local ok,result=pcall(require,module)
  if ok and type(result)=="table" and type(result.tap)=="function" then attackInput=result end
 end
end)
toggle.Activated:Connect(function()
 enabled=not enabled candidate=nil
 toggle.Text=enabled and "TRIGGER TEST: ON" or "TRIGGER TEST: OFF"
 toggle.BackgroundColor3=enabled and Color3.fromRGB(48,120,89) or Color3.fromRGB(49,67,100)
end)
delayBox.FocusLost:Connect(function()
 local n=tonumber(delayBox.Text)
 if not n or n~=n or math.abs(n)==math.huge then n=delaySeconds*1000 end
 n=math.clamp(n,0,5000) delaySeconds=n/1000 delayBox.Text=tostring(n) candidate=nil
end)
UIS.InputBegan:Connect(function(input,processed)
 if not processed and not UIS:GetFocusedTextBox() and input.KeyCode==Enum.KeyCode.RightShift then panel.Visible=not panel.Visible end
end)

local overlay=nil
local bodyPairs={}
local originalTransparency={}
local originalDecals={}
local avatarGeneration=0
local function clearAvatar()
 if overlay then overlay:Destroy() overlay=nil end
 table.clear(bodyPairs)
 for p,value in originalTransparency do if p.Parent then p.LocalTransparencyModifier=value end end
 for p,value in originalDecals do if p.Parent then p.Transparency=value end end
 table.clear(originalTransparency) table.clear(originalDecals)
end
local function hidePart(p)
 if p:IsA("BasePart") then
  if originalTransparency[p]==nil then originalTransparency[p]=p.LocalTransparencyModifier end
  p.LocalTransparencyModifier=1
 elseif p:IsA("Decal") then
  if originalDecals[p]==nil then originalDecals[p]=p.Transparency end
  p.Transparency=1
 end
end
local function renderAvatar(name)
 avatarGeneration+=1 local generation=avatarGeneration
 status.Text="Loading avatar…"
 local character=player.Character
 local humanoid=character and character:FindFirstChildOfClass("Humanoid")
 if not humanoid then status.Text="Spawn your character first." return end
 local ok,result=pcall(function()
  local userId=Players:GetUserIdFromNameAsync(name)
  local description=Players:GetHumanoidDescriptionFromUserIdAsync(userId)
  local model=Players:CreateHumanoidModelFromDescriptionAsync(description,humanoid.RigType)
  description:Destroy()
  return model
 end)
 if generation~=avatarGeneration or character~=player.Character then
  if ok then result:Destroy() end return
 end
 if not ok then status.Text="Could not load that username. Try again." return end
 clearAvatar()
 overlay=result overlay.Name="kintestAvatarPreview"
 for _,d in overlay:GetDescendants() do
  if d:IsA("BaseScript") then d:Destroy()
  elseif d:IsA("BasePart") then d.Anchored=true d.CanCollide=false d.CanTouch=false d.CanQuery=false d.CastShadow=false
  elseif d:IsA("Humanoid") then d.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None end
 end
 local pairsByPart={}
 for _,p in overlay:GetChildren() do
  if p:IsA("BasePart") then
   local live=character:FindFirstChild(p.Name)
   if live and live:IsA("BasePart") then
    pairsByPart[p]=live
    table.insert(bodyPairs,{part=p,live=live,offset=CFrame.identity})
   end
  end
 end
 for _,accessory in overlay:GetChildren() do
  if accessory:IsA("Accessory") then
   for _,p in accessory:GetDescendants() do
    if p:IsA("BasePart") then
     local weld=p:FindFirstChild("AccessoryWeld")
     local body=weld and weld.Part1
     if body and pairsByPart[body] then
      table.insert(bodyPairs,{part=p,live=pairsByPart[body],offset=body.CFrame:ToObjectSpace(p.CFrame)})
     else p.Transparency=1 end
    end
   end
  end
 end
 for _,p in character:GetDescendants() do
  if not p:FindFirstAncestorOfClass("Tool") then hidePart(p) end
 end
 overlay.Parent=workspace
 status.Text="Previewing @"..name.." • only visible to you"
end
apply.Activated:Connect(function()
 local name=username.Text:match("^%s*@?([%w_]+)%s*$")
 if not name or #name<3 or #name>20 then status.Text="Enter a valid Roblox username." return end
 task.spawn(renderAvatar,name)
end)
reset.Activated:Connect(function()
 avatarGeneration+=1 clearAvatar() status.Text="Original avatar restored."
end)
player.CharacterAdded:Connect(function()
 avatarGeneration+=1 clearAvatar() candidate=nil
 status.Text="Respawned • original avatar restored."
end)

local function visibleOpponent()
 local char=player.Character local camera=workspace.CurrentCamera
 local hum=char and char:FindFirstChildOfClass("Humanoid")
 if not camera or not hum or hum.Health<=0 or UIS:GetFocusedTextBox() then return nil end
 if attackInput and attackInput.isCapturing and attackInput.isCapturing() then return nil end
 if player:GetAttribute("ReplayViewing") or player:GetAttribute("Spectating") then return nil end
 local pos=camera.ViewportSize/2
 if UIS.MouseBehavior~=Enum.MouseBehavior.LockCenter then
  local inset=game:GetService("GuiService"):GetGuiInset()
  pos=UIS:GetMouseLocation()-inset
 end
 local ray=camera:ViewportPointToRay(pos.X,pos.Y)
 local rp=RaycastParams.new() rp.FilterType=Enum.RaycastFilterType.Exclude
 local excluded={char,camera}
 if overlay then table.insert(excluded,overlay) end
 rp.FilterDescendantsInstances=excluded
 local hit=workspace:Raycast(ray.Origin,ray.Direction*1500,rp)
 if not hit then return nil end
 local model=hit.Instance:FindFirstAncestorOfClass("Model")
 while model and not model:FindFirstChildOfClass("Humanoid") do model=model.Parent and model.Parent:FindFirstAncestorOfClass("Model") end
 local other=model and Players:GetPlayerFromCharacter(model)
 local targetHum=model and model:FindFirstChildOfClass("Humanoid")
 if not other or other==player or not targetHum or targetHum.Health<=0 then return nil end
 if not player.Neutral and not other.Neutral and player.Team==other.Team then return nil end
 local myMatch=player:GetAttribute("DuelId") or player:GetAttribute("MatchId")
 local theirMatch=other:GetAttribute("DuelId") or other:GetAttribute("MatchId")
 if myMatch and theirMatch and myMatch~=theirMatch then return nil end
 if model:FindFirstChildOfClass("ForceField") then return nil end
 return other
end

local connection=RunService.RenderStepped:Connect(function()
 if overlay then
  local camera=workspace.CurrentCamera
  local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  local firstPerson=camera and root and (camera.CFrame.Position-root.Position).Magnitude<2
  for p in originalTransparency do if p.Parent then p.LocalTransparencyModifier=1 end end
  for _,pair in bodyPairs do
   if pair.part.Parent and pair.live.Parent then
    pair.part.CFrame=pair.live.CFrame*pair.offset
    pair.part.LocalTransparencyModifier=firstPerson and 1 or 0
   end
  end
 end
 if not enabled then candidate=nil return end
 local target=visibleOpponent()
 local now=os.clock()
 if not target then candidate=nil targetLabel.Text="No visible opponent under crosshair." return end
 if candidate~=target then candidate=target acquired=now end
 targetLabel.Text="Visible: @"..target.Name.." • "..math.max(0,math.ceil((delaySeconds-(now-acquired))*1000)).." ms"
 if now-acquired<delaySeconds or now<nextFire then return end
 -- Resolve visibility again after the delay; never aim or shoot through geometry.
 if visibleOpponent()~=target then candidate=nil return end
 nextFire=now+math.max(delaySeconds,.08)
 acquired=now
 if attackInput then
  attackInput.tap("Attack")
 else
  local tool=player.Character and player.Character:FindFirstChildOfClass("Tool")
  if tool then tool:Activate() else targetLabel.Text="Waiting for the weapon input controller." end
 end
end)
gui.Destroying:Connect(function()
 enabled=false avatarGeneration+=1 connection:Disconnect() clearAvatar()
end)
