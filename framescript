local spoofConns={}
local function spoofText(lbl,text)
 if not lbl then return end
 if spoofConns[lbl] then spoofConns[lbl]:Disconnect() end
 local desired=text
 local locked=false
 spoofConns[lbl]=lbl:GetPropertyChangedSignal("Text"):Connect(function()
  if locked then return end
  if lbl.Text~=desired then locked=true lbl.Text=desired locked=false end
 end)
 locked=true lbl.Text=desired locked=false
end
local function unspoofText(lbl)
 if spoofConns[lbl] then spoofConns[lbl]:Disconnect() spoofConns[lbl]=nil end
end
local function unspoofAll()
 for _,c in spoofConns do c:Disconnect() end
 table.clear(spoofConns)
end

