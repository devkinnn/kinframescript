 if verifiedEnabled then refreshVerifiedBadge() else clearVerifiedTag() end
end)

-- display spoof
local savedDisplayName=nil
local savedLevel=nil
local savedLevelAttr=nil
local savedStreak=nil
local savedStreakAttr=nil

local function applySpoofs()
 local char=player.Character
 local hum=char and char:FindFirstChildOfClass("Humanoid")
 local oh=char and char:FindFirstChild("OVERHEAD")

 local nick=nicknameBox.Text:match("^%s*(.-)%s*$")
 if nick and #nick>0 then
  if hum then
   if not savedDisplayName then savedDisplayName=hum.DisplayName end
   hum.DisplayName=nick
  end
  if oh then
   local nl=oh:FindFirstChild("NameLabel",true)
   if nl then
    local txt=nick
    if verifiedEnabled then txt=txt.." "..VERIFIED end
    spoofText(nl,txt)
   end
  end
 end

 local lv=tonumber(levelBox.Text)
 if lv then
  local ls=player:FindFirstChild("leaderstats")
  if ls then
   local stat=ls:FindFirstChild("Level")
   if stat and stat:IsA("ValueBase") then
    if not savedLevel then savedLevel={obj=stat,val=stat.Value} end
    stat.Value=lv
   end
  end
  local oldAttr=player:GetAttribute("Level")
  if oldAttr~=nil then
   if not savedLevelAttr then savedLevelAttr=oldAttr end
   player:SetAttribute("Level",lv)
  end
  if oh then
   local ll=oh:FindFirstChild("Level",true)
   if ll and (ll:IsA("TextLabel") or ll:IsA("TextButton")) then spoofText(ll,tostring(lv)) end
  end
 end

 local sk=tonumber(streakBox.Text)
 if sk then
  local ls=player:FindFirstChild("leaderstats")
  if ls then
   local stat=ls:FindFirstChild("Win Streak")
   if stat and stat:IsA("ValueBase") then
    if not savedStreak then savedStreak={obj=stat,val=stat.Value} end
    stat.Value=sk
   end
  end
  local oldAttr=player:GetAttribute("WinStreak")
  if oldAttr~=nil then
   if not savedStreakAttr then savedStreakAttr=oldAttr end
   player:SetAttribute("WinStreak",sk)
  end
  if oh then
   local sl=oh:FindFirstChild("Label",true)
   if sl and (sl:IsA("TextLabel") or sl:IsA("TextButton")) then spoofText(sl,tostring(sk)) end
  end
 end

 status.Text="Changes applied (local only)."
end

local function resetSpoofs()
 local char=player.Character
 local hum=char and char:FindFirstChildOfClass("Humanoid")
 if hum and savedDisplayName then hum.DisplayName=savedDisplayName savedDisplayName=nil end
 if savedLevel then
  if savedLevel.obj and savedLevel.obj.Parent then savedLevel.obj.Value=savedLevel.val end
  savedLevel=nil
 end
 if savedLevelAttr~=nil then player:SetAttribute("Level",savedLevelAttr) savedLevelAttr=nil end
 if savedStreak then
  if savedStreak.obj and savedStreak.obj.Parent then savedStreak.obj.Value=savedStreak.val end
  savedStreak=nil
 end
 if savedStreakAttr~=nil then player:SetAttribute("WinStreak",savedStreakAttr) savedStreakAttr=nil end
 unspoofAll()
 nicknameBox.Text="" levelBox.Text="" streakBox.Text=""
 if verifiedEnabled then task.defer(refreshVerifiedBadge) end
 status.Text="Display restored to original."
end

