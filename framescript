-- spoof text helper: persists text even if the game overwrites it
local spoofConns={}
local function spoofText(lbl,text)
 if not lbl then return end
 if spoofConns[lbl] then spoofConns[lbl]:Disconnect() end
 local desired=text
 local locked=false
 spoofConns[lbl]=lbl:GetPropertyChangedSignal("Text"):Connect(function()
  if locked then return end
  if lbl.Text~=desired then locked=true lbl.Text=desired locked=false end
 end)
 locked=true lbl.Text=desired locked=false
end
local function unspoofText(lbl)
 if spoofConns[lbl] then spoofConns[lbl]:Disconnect() spoofConns[lbl]=nil end
end
local function unspoofAll()
 for _,c in spoofConns do c:Disconnect() end
 table.clear(spoofConns)
end

-- verified badge
local verifiedEnabled=false
local VERIFIED=utf8.char(0xE000)

local function getOverheadName()
 local char=player.Character
 if not char then return nil end
 local oh=char:FindFirstChild("OVERHEAD")
 if not oh then return nil end
 return oh:FindFirstChild("NameLabel",true)
end

local function refreshVerifiedBadge()
 local nl=getOverheadName()
 if not nl then return end
 local txt=nl.Text:gsub(" ?"..VERIFIED,"")
 if verifiedEnabled then txt=txt.." "..VERIFIED end
 spoofText(nl,txt)
end

local function clearVerifiedTag()
 local nl=getOverheadName()
 if nl then
  local clean=nl.Text:gsub(" ?"..VERIFIED,"")
  unspoofText(nl)
  nl.Text=clean
 end
end

