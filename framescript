local activeKnifeSkin=nil
local activeRevolverSkin=nil
local originalKnifeAttrs=nil
local originalRevolverAttrs=nil
local skinGuardConns={}
local _knifeApplying=false
local _revolverApplying=false

local KNIFE_ATTR_KEYS={"KnifeSkin","KnifeName","KnifeRarity","KnifeIcon","KnifeSerial","KnifeMaxSupply","KnifeKillcam","ThrowEffect"}
local REVOLVER_ATTR_KEYS={"RevolverSkin","RevolverName","RevolverRarity","RevolverIcon"}

local function findRigMotor(char,rootName)
 for _,d in char:GetDescendants() do
  if d:IsA("Motor6D") and d.Part1 and d.Part1.Name==rootName then return d end
 end
 return nil
end

local _ATTR_NIL=newproxy()
local function saveAttrs(keys)
 local s={} for _,k in keys do local v=player:GetAttribute(k) s[k]=(v==nil and _ATTR_NIL or v) end return s
end
local function restoreAttrs(saved)
 for k,v in saved do
  if v==_ATTR_NIL then player:SetAttribute(k,nil) else player:SetAttribute(k,v) end
 end
end

local function clearWeaponSkin()
 for _,c in skinGuardConns do c:Disconnect() end
 table.clear(skinGuardConns)
 local char=player.Character
 if activeKnifeSkin and originalKnifeAttrs then
  _knifeApplying=true
  restoreAttrs(originalKnifeAttrs)
  if char then
   local origSkin=originalKnifeAttrs.KnifeSkin
   if origSkin and origSkin~=_ATTR_NIL then
    local motor=findRigMotor(char,"KnifeRoot")
    if motor then pcall(WRU.ApplyKnifeSkin,char,origSkin,motor.Part0,motor.Name) end
   end
  end
  pcall(function() Bindables.AnimateSkins:Fire() end)
  _knifeApplying=false
  originalKnifeAttrs=nil activeKnifeSkin=nil
 end
 if activeRevolverSkin and originalRevolverAttrs then
  _revolverApplying=true
  restoreAttrs(originalRevolverAttrs)
  if char then
   local origSkin=originalRevolverAttrs.RevolverSkin
   if origSkin and origSkin~=_ATTR_NIL then
    local motor=findRigMotor(char,"RevolverRoot")
    if motor then pcall(WRU.ApplyRevolverSkin,char,origSkin,motor.Part0,motor.Name) end
   end
  end
  pcall(function() Bindables.AnimateSkins:Fire() end)
  _revolverApplying=false
  originalRevolverAttrs=nil activeRevolverSkin=nil
 end
 skinStatus.Text="Original skins restored."
end

local function applyKnifeSkinFull(skinName)
 if _knifeApplying then return end
 _knifeApplying=true
 local char=player.Character
 if not char then skinStatus.Text="Spawn first." _knifeApplying=false return end
 if not WRU.GetKnifeTemplate(skinName) then skinStatus.Text="'"..skinName.."' not in game." _knifeApplying=false return end
 if not originalKnifeAttrs then originalKnifeAttrs=saveAttrs(KNIFE_ATTR_KEYS) end
 local motor=findRigMotor(char,"KnifeRoot")
 local part0,motorName,savedC0,savedC1
 if motor then
  part0=motor.Part0 motorName=motor.Name savedC0=motor.C0 savedC1=motor.C1
 else
  part0=char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
  motorName="Knife_HipAttach_R"
 end
 if not part0 then skinStatus.Text="No attachment point." _knifeApplying=false return end
 player:SetAttribute("ThrowEffect",skinName.."Trail")
 player:SetAttribute("KnifeSkin",skinName)
 local newRig,newRoot=WRU.ApplyKnifeSkin(char,skinName,part0,motorName)
 if newRig then
  newRig:SetAttribute("ClientVisible",true)
  newRig:SetAttribute("_kintest",skinName)
  local isHand=part0.Name=="Right Arm" or part0.Name=="RightHand"
  if not isHand and savedC0 then
   local m2=findRigMotor(char,"KnifeRoot")
   if m2 then m2.C0=savedC0 m2.C1=savedC1 end
  end
  pcall(function() Bindables.AnimateSkins:Fire() end)
  activeKnifeSkin=skinName
  skinStatus.Text="Knife -> "..skinName.." ok"
  if skinGuardConns.knife then skinGuardConns.knife:Disconnect() end
  skinGuardConns.knife=char.ChildAdded:Connect(function(child)
   if child.Name=="KnifeRig" and activeKnifeSkin and not _knifeApplying then
    if child:GetAttribute("_kintest")==activeKnifeSkin then return end
    task.wait(0.2)
    if not activeKnifeSkin or player.Character~=char or _knifeApplying then return end
    local existing=char:FindFirstChild("KnifeRig")
    if existing and existing:GetAttribute("_kintest")==activeKnifeSkin then return end
    applyKnifeSkinFull(activeKnifeSkin)
   end
  end)
 else
  skinStatus.Text="Knife skin failed."
 end
 _knifeApplying=false
end

local function applyRevolverSkinFull(skinName)
 if _revolverApplying then return end
 _revolverApplying=true
 local char=player.Character
 if not char then skinStatus.Text="Spawn first." _revolverApplying=false return end
 if not WRU.GetRevolverTemplate(skinName) then skinStatus.Text="'"..skinName.."' not in game." _revolverApplying=false return end
 if not originalRevolverAttrs then originalRevolverAttrs=saveAttrs(REVOLVER_ATTR_KEYS) end
 local motor=findRigMotor(char,"RevolverRoot")
 local part0,motorName,savedC0,savedC1
 if motor then
  part0=motor.Part0 motorName=motor.Name savedC0=motor.C0 savedC1=motor.C1
 else
  part0=char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
  motorName="Revolver_HipAttach_L"
 end
 if not part0 then skinStatus.Text="No attachment point." _revolverApplying=false return end
 player:SetAttribute("RevolverSkin",skinName)
 local newRig,newRoot=WRU.ApplyRevolverSkin(char,skinName,part0,motorName)
 if newRig then
  newRig:SetAttribute("ClientVisible",true)
  newRig:SetAttribute("_kintest",skinName)
  local function _nukeScope(inst)
   if inst:IsA("StringValue") and inst.Name=="ScopeType" then inst:Destroy() return end
   if inst:IsA("CFrameValue") and inst.Name=="ADSOffset" then inst:Destroy() return end
   if inst.Name=="Scope" and (inst:IsA("MeshPart") or inst:IsA("Weld") or inst:IsA("WeldConstraint") or inst:IsA("Part")) then inst:Destroy() return end
   if inst:IsA("BillboardGui") or inst:IsA("SurfaceGui") then inst.Enabled=false end
  end
  for _,d in newRig:GetDescendants() do _nukeScope(d) end
  if skinGuardConns.scopeStrip then skinGuardConns.scopeStrip:Disconnect() end
  skinGuardConns.scopeStrip=newRig.DescendantAdded:Connect(function(d) _nukeScope(d) end)
  pcall(function()
   local tpl=RS.Revolvers:FindFirstChild(skinName)
   if tpl then
    local tRoot=tpl:FindFirstChild("RevolverRoot")
    if tRoot then
     local st=tRoot:FindFirstChild("ScopeType") if st then st:Destroy() end
     local ads=tRoot:FindFirstChild("ADSOffset") if ads then ads:Destroy() end
     local rifle=tRoot:FindFirstChild("Rifle")
     if rifle then
      local sc=rifle:FindFirstChild("Scope") if sc then sc:Destroy() end
     end
    end
   end
  end)
  local isHand=part0.Name=="Right Arm" or part0.Name=="RightHand" or part0.Name=="Left Arm" or part0.Name=="LeftHand"
  if not isHand and savedC0 then
   local m2=findRigMotor(char,"RevolverRoot")
   if m2 then m2.C0=savedC0 m2.C1=savedC1 end
  end
  pcall(function() Bindables.AnimateSkins:Fire() end)
  activeRevolverSkin=skinName
  skinStatus.Text="Revolver -> "..skinName.." ok"
  if skinGuardConns.revolver then skinGuardConns.revolver:Disconnect() end
  skinGuardConns.revolver=char.ChildAdded:Connect(function(child)
   if child.Name=="RevolverRig" and activeRevolverSkin and not _revolverApplying then
    if child:GetAttribute("_kintest")==activeRevolverSkin then return end
    task.wait(0.2)
    if not activeRevolverSkin or player.Character~=char or _revolverApplying then return end
    local existing=char:FindFirstChild("RevolverRig")
    if existing and existing:GetAttribute("_kintest")==activeRevolverSkin then return end
    applyRevolverSkinFull(activeRevolverSkin)
   end
  end)
 else
  skinStatus.Text="Revolver skin failed."
 end
 _revolverApplying=false
end

