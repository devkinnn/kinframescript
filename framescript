-- config system
local function ensureFolder()
 pcall(function() if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end end)
end

local function getAutoloadName()
 local ok,result=pcall(function()
  local path=CONFIG_FOLDER.."/autoload.txt"
  if isfile(path) then return readfile(path) end
  return nil
 end)
 if ok and result and #result>0 then return result end
 return nil
end

local function updateAutoloadLabel()
 local name=getAutoloadName()
 autoloadBtn.Text=name and ("AUTOLOAD: "..name) or "SET AUTOLOAD"
end

local function buildConfigData()
 return {
  nickname=nicknameBox.Text,
  level=levelBox.Text,
  streak=streakBox.Text,
  verified=verifiedEnabled,
  trigger=enabled,
  delay=delaySeconds*1000,
  avatar=usernameBox.Text
 }
end

local function applyConfigData(data)
 if data.nickname then nicknameBox.Text=tostring(data.nickname) end
 if data.level then levelBox.Text=tostring(data.level) end
 if data.streak then streakBox.Text=tostring(data.streak) end
 if data.avatar then usernameBox.Text=tostring(data.avatar) end
 if data.delay then
  local n=tonumber(data.delay) or 150
  delaySeconds=n/1000
  delayBox.Text=tostring(n)
 end
 if data.trigger~=nil and data.trigger~=enabled then
  enabled=data.trigger candidate=nil
  triggerToggle.Text=enabled and "TRIGGER TEST: ON" or "TRIGGER TEST: OFF"
  triggerToggle.BackgroundColor3=enabled and Color3.fromRGB(48,120,89) or Color3.fromRGB(49,67,100)
 end
 if data.verified~=nil and data.verified~=verifiedEnabled then
  verifiedEnabled=data.verified
  verifiedToggle.Text=verifiedEnabled and "BADGE: ON" or "BADGE: OFF"
  verifiedToggle.BackgroundColor3=verifiedEnabled and Color3.fromRGB(48,120,89) or Color3.fromRGB(49,67,100)
 end
 -- apply nickname/level/streak to overhead
 local nick=nicknameBox.Text:match("^%s*(.-)%s*$")
 if (nick and #nick>0) or tonumber(levelBox.Text) or tonumber(streakBox.Text) then
  applySpoofs()
 end
 if verifiedEnabled then refreshVerifiedBadge() end
 -- apply avatar if set
 if data.avatar and #tostring(data.avatar)>0 then
  local aname=tostring(data.avatar):match("^%s*@?([%w_]+)%s*$")
  if aname and #aname>=3 and #aname<=20 then
   task.spawn(renderAvatar,aname)
  end
 end
end

